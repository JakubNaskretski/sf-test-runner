{
  "name": "sf-test-runner",
  "displayName": "Salesforce Test Runner",
  "description": "Run Apex tests in VS Code's Test Explorer, with coverage attached to the run that produced it. Every sf CLI command we execute is listed in a collapsible panel. Reuses your existing sf CLI auth.",
  "version": "0.8.0",
  "publisher": "Skrety",
  "icon": "icons/plugin-icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "salesforce",
    "apex",
    "test",
    "coverage",
    "sf",
    "sfdx"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:apex",
    "onView:sfTestRunner.commands",
    "workspaceContains:**/*.cls"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sfTestRunner.runAllLocal",
        "title": "SF Tests: Run All Local Tests",
        "icon": "$(run-all)"
      },
      {
        "command": "sfTestRunner.loadRecentRuns",
        "title": "SF Tests: Load Recent Test Runs",
        "icon": "$(history)"
      },
      {
        "command": "sfTestRunner.refreshCoverage",
        "title": "SF Tests: Load Coverage from Org",
        "icon": "$(cloud-download)"
      },
      {
        "command": "sfTestRunner.selectOrg",
        "title": "SF Tests: Select Target Org",
        "icon": "$(plug)"
      },
      {
        "command": "sfTestRunner.refreshOrgs",
        "title": "SF Tests: Refresh Org List"
      },
      {
        "command": "sfTestRunner.clearCommandHistory",
        "title": "SF Tests: Clear Command History",
        "icon": "$(clear-all)"
      },
      {
        "command": "sfTestRunner.copyCommand",
        "title": "SF Tests: Copy Command",
        "icon": "$(copy)"
      },
      {
        "command": "sfTestRunner.showOutput",
        "title": "SF Tests: Show Output Channel",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sfTestRunner.copyCommand",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sfTestRunner.clearCommandHistory",
          "when": "view == sfTestRunner.commands",
          "group": "navigation@1"
        },
        {
          "command": "sfTestRunner.showOutput",
          "when": "view == sfTestRunner.commands",
          "group": "navigation@2"
        },
        {
          "command": "sfTestRunner.selectOrg",
          "when": "view == sfTestRunner.commands"
        },
        {
          "command": "sfTestRunner.runAllLocal",
          "when": "view == sfTestRunner.commands"
        },
        {
          "command": "sfTestRunner.loadRecentRuns",
          "when": "view == sfTestRunner.commands"
        },
        {
          "command": "sfTestRunner.refreshCoverage",
          "when": "view == sfTestRunner.commands"
        }
      ],
      "view/item/context": [
        {
          "command": "sfTestRunner.copyCommand",
          "when": "view == sfTestRunner.commands && viewItem == sfCommand",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sfTestRunner",
          "title": "SF Tests",
          "icon": "icons/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "sfTestRunner": [
        {
          "id": "sfTestRunner.commands",
          "name": "Recent sf Commands",
          "icon": "$(terminal)",
          "contextualTitle": "Salesforce Test Runner"
        }
      ]
    },
    "configuration": {
      "title": "Salesforce Test Runner",
      "properties": {
        "sfTestRunner.testTimeoutMs": {
          "type": "number",
          "default": 600000,
          "minimum": 60000,
          "description": "Hard timeout (ms) for `sf apex run test`. Also drives the --wait minutes flag."
        },
        "sfTestRunner.autoShowOutput": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the SF Tests output channel when a test run starts or a recent run is loaded. Opening a test result always reveals it."
        },
        "sfTestRunner.syncOrgWithFamily": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Follow and publish the Salesforce org shared across the Skrety SF plugins (`skrety.salesforce.targetOrg`). Off: this plugin keeps its own org and ignores switches made in sibling plugins."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npx -y @vscode/vsce@latest package --no-dependencies --allow-missing-repository",
    "publish": "npx -y @vscode/vsce@latest publish --no-dependencies --allow-missing-repository",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p ./tsconfig.test.json",
    "test": "node --test \"out-test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.88.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  }
}
