{
  "name": "sf-test-runner",
  "displayName": "Salesforce Test Runner",
  "description": "Run Apex tests from a sidebar panel: pick the target org, tick classes and methods across local and org tests, read parsed results with clickable failures, and see coverage in the Coverage view and painted on your editor lines. Every sf CLI command we execute is listed in a collapsible log. Reuses your existing sf CLI auth.",
  "version": "0.8.0",
  "publisher": "Skrety",
  "icon": "icons/plugin-icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "salesforce",
    "apex",
    "test",
    "coverage",
    "sf",
    "sfdx"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:apex",
    "onView:sfTestRunner.tests",
    "onView:sfTestRunner.results",
    "onView:sfTestRunner.coverage",
    "onView:sfTestRunner.commands",
    "workspaceContains:**/*.cls"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sfTestRunner.runSelected",
        "title": "SF Tests: Run Selected Tests",
        "icon": "$(run)"
      },
      {
        "command": "sfTestRunner.runAllLocal",
        "title": "SF Tests: Run All Local Tests",
        "icon": "$(run-all)"
      },
      {
        "command": "sfTestRunner.runAllInOrg",
        "title": "SF Tests: Run All Tests in Org (incl. managed)"
      },
      {
        "command": "sfTestRunner.cancelRun",
        "title": "SF Tests: Cancel Test Run",
        "icon": "$(stop-circle)"
      },
      {
        "command": "sfTestRunner.rescan",
        "title": "SF Tests: Rescan Workspace for Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "sfTestRunner.fetchOrgTests",
        "title": "SF Tests: Fetch Test Classes from Org",
        "icon": "$(cloud-download)"
      },
      {
        "command": "sfTestRunner.selectOrg",
        "title": "SF Tests: Select Target Org",
        "icon": "$(plug)"
      },
      {
        "command": "sfTestRunner.refreshOrgs",
        "title": "SF Tests: Refresh Org List"
      },
      {
        "command": "sfTestRunner.loginOrg",
        "title": "SF Tests: Log In to an Org",
        "icon": "$(add)"
      },
      {
        "command": "sfTestRunner.testsForActiveFile",
        "title": "SF Tests: Select Tests for Active File"
      },
      {
        "command": "sfTestRunner.rerunFailed",
        "title": "SF Tests: Re-run Failed Tests",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "sfTestRunner.copySummary",
        "title": "SF Tests: Copy Run Summary",
        "icon": "$(copy)"
      },
      {
        "command": "sfTestRunner.loadRecentRuns",
        "title": "SF Tests: Load Recent Test Runs",
        "icon": "$(history)"
      },
      {
        "command": "sfTestRunner.expandResults",
        "title": "SF Tests: Expand All Results",
        "icon": "$(expand-all)"
      },
      {
        "command": "sfTestRunner.collapseResults",
        "title": "SF Tests: Collapse All Results",
        "icon": "$(collapse-all)"
      },
      {
        "command": "sfTestRunner.toggleCoveragePaint",
        "title": "SF Tests: Toggle Coverage Painting",
        "icon": "$(eye)"
      },
      {
        "command": "sfTestRunner.clearCoverage",
        "title": "SF Tests: Clear Coverage",
        "icon": "$(clear-all)"
      },
      {
        "command": "sfTestRunner.refreshCoverage",
        "title": "SF Tests: Load Coverage from Org",
        "icon": "$(cloud-download)"
      },
      {
        "command": "sfTestRunner.runClass",
        "title": "SF Tests: Run Test Class"
      },
      {
        "command": "sfTestRunner.runMethod",
        "title": "SF Tests: Run Test Method"
      },
      {
        "command": "sfTestRunner.clearCommandHistory",
        "title": "SF Tests: Clear Command History",
        "icon": "$(clear-all)"
      },
      {
        "command": "sfTestRunner.copyCommand",
        "title": "SF Tests: Copy Command",
        "icon": "$(copy)"
      },
      {
        "command": "sfTestRunner.showOutput",
        "title": "SF Tests: Show Output Channel",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sfTestRunner.copyCommand",
          "when": "false"
        },
        {
          "command": "sfTestRunner.runClass",
          "when": "false"
        },
        {
          "command": "sfTestRunner.runMethod",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sfTestRunner.selectOrg",
          "when": "view == sfTestRunner.tests",
          "group": "navigation@1"
        },
        {
          "command": "sfTestRunner.rescan",
          "when": "view == sfTestRunner.tests",
          "group": "navigation@2"
        },
        {
          "command": "sfTestRunner.fetchOrgTests",
          "when": "view == sfTestRunner.tests",
          "group": "navigation@3"
        },
        {
          "command": "sfTestRunner.loadRecentRuns",
          "when": "view == sfTestRunner.tests",
          "group": "navigation@4"
        },
        {
          "command": "sfTestRunner.expandResults",
          "when": "view == sfTestRunner.results",
          "group": "navigation@1"
        },
        {
          "command": "sfTestRunner.collapseResults",
          "when": "view == sfTestRunner.results",
          "group": "navigation@2"
        },
        {
          "command": "sfTestRunner.rerunFailed",
          "when": "view == sfTestRunner.results",
          "group": "navigation@3"
        },
        {
          "command": "sfTestRunner.copySummary",
          "when": "view == sfTestRunner.results",
          "group": "navigation@4"
        },
        {
          "command": "sfTestRunner.toggleCoveragePaint",
          "when": "view == sfTestRunner.coverage",
          "group": "navigation@1"
        },
        {
          "command": "sfTestRunner.clearCoverage",
          "when": "view == sfTestRunner.coverage",
          "group": "navigation@2"
        },
        {
          "command": "sfTestRunner.clearCommandHistory",
          "when": "view == sfTestRunner.commands",
          "group": "navigation@1"
        },
        {
          "command": "sfTestRunner.showOutput",
          "when": "view == sfTestRunner.commands",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sfTestRunner.copyCommand",
          "when": "view == sfTestRunner.commands && viewItem == sfCommand",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sfTestRunner",
          "title": "SF Tests",
          "icon": "icons/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "sfTestRunner": [
        {
          "id": "sfTestRunner.tests",
          "type": "webview",
          "name": "Tests",
          "contextualTitle": "Salesforce Test Runner"
        },
        {
          "id": "sfTestRunner.results",
          "type": "webview",
          "name": "Results",
          "contextualTitle": "Salesforce Test Runner"
        },
        {
          "id": "sfTestRunner.coverage",
          "type": "webview",
          "name": "Coverage",
          "contextualTitle": "Salesforce Test Runner"
        },
        {
          "id": "sfTestRunner.commands",
          "name": "Command log",
          "icon": "$(terminal)",
          "visibility": "collapsed",
          "contextualTitle": "Salesforce Test Runner"
        }
      ]
    },
    "configuration": {
      "title": "Salesforce Test Runner",
      "properties": {
        "sfTestRunner.testTimeoutMs": {
          "type": "number",
          "default": 600000,
          "minimum": 60000,
          "description": "Ceiling (ms) for waiting on a test run: the run is started asynchronously and polled until it finishes or this much time passes (then it is reported as still running in the org)."
        },
        "sfTestRunner.autoShowOutput": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the SF Tests output channel when a test run starts or a recent run is loaded. Opening a test result always reveals it."
        },
        "sfTestRunner.runWithCoverage": {
          "type": "boolean",
          "default": true,
          "description": "Ask for code coverage when running tests (the \"with coverage\" chip in the Tests view mirrors this)."
        },
        "sfTestRunner.paintCoverage": {
          "type": "boolean",
          "default": true,
          "description": "Paint covered and uncovered lines in the editor after a coverage run. Coverage only ever comes from this plugin's own run or an explicit per-class load from the org."
        },
        "sfTestRunner.fetchOrgTestsOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Query the org for its test classes when the panel opens. Off by default: the org is only contacted when you ask for it."
        },
        "sfTestRunner.syncOrgWithFamily": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Follow and publish the Salesforce org shared across the Skrety SF plugins (`skrety.salesforce.targetOrg`). Off: this plugin keeps its own org and ignores switches made in sibling plugins."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npx -y @vscode/vsce@latest package --no-dependencies --allow-missing-repository",
    "publish": "npx -y @vscode/vsce@latest publish --no-dependencies --allow-missing-repository",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webview/tsconfig.json",
    "pretest": "tsc -p ./tsconfig.test.json",
    "test": "node --test \"out-test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.88.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  }
}
